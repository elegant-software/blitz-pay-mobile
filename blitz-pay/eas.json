{
  "cli": {
    "version": ">= 12.0.0",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "prebuildCommand": "expo prebuild --clean",
      "channel": "development"
    },
    "preview": {
      "distribution": "internal",
      "ios": {
        "simulator": true
      },
      "channel": "preview"
    },
    "aws-staging": {
      "distribution": "internal",
      "env": {
        "EXPO_PUBLIC_API_URL": "https://api.zackpay.de",
        "EXPO_PUBLIC_KEYCLOAK_URL": "https://auth.zackpay.de",
        "EXPO_PUBLIC_KEYCLOAK_REALM": "blitzpay",
        "EXPO_PUBLIC_KEYCLOAK_CLIENT_ID": "blitzpay-mobile",
        "EXPO_PUBLIC_AUTH_BYPASS": "true"
      },
      "channel": "aws-staging"
    },
    "production": {
      "autoIncrement": true,
      "channel": "production"
    }
  },
  "submit": {
    "production": {}
  }
}
