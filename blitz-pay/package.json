{
  "name": "blitzpay-mobile",
  "version": "1.0.0",
  "main": "index.js",
  "scripts": {
    "postinstall": "patch-package",
    "start": "expo start",
    "web": "expo start --web",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "build:eas:async": "node ./scripts/eas-build-async.js",
    "build:eas:async:clear-cache": "EAS_CLEAR_CACHE=1 node ./scripts/eas-build-async.js",
    "lint": "tsc --noEmit",
    "typecheck": "tsc --noEmit --pretty false",
    "test": "jest --testPathPattern=__tests__",
    "test:device": "node ./scripts/device-tests.js",
    "test:contract": "jest --testPathPattern=__contract__"
  },
  "dependencies": {
    "@expo/metro-runtime": "~55.0.11",
    "@expo/vector-icons": "^15.0.2",
    "@react-navigation/bottom-tabs": "^6.6.1",
    "@react-navigation/native": "^6.1.18",
    "@react-navigation/native-stack": "^6.11.0",
    "@stripe/stripe-react-native": "^0.65.0",
    "@tanstack/query-async-storage-persister": "^5.100.11",
    "@tanstack/react-query": "^5.100.11",
    "@tanstack/react-query-persist-client": "^5.100.11",
    "eol": "^0.10.0",
    "expo": "~55.0.27",
    "expo-asset": "~55.0.17",
    "expo-audio": "~55.0.15",
    "expo-build-properties": "~55.0.15",
    "expo-camera": "~55.0.20",
    "expo-clipboard": "~55.0.14",
    "expo-dev-client": "~55.0.36",
    "expo-device": "~55.0.18",
    "expo-font": "~55.0.8",
    "expo-haptics": "~55.0.15",
    "expo-image": "~55.0.11",
    "expo-linear-gradient": "~55.0.15",
    "expo-local-authentication": "~55.0.15",
    "expo-location": "~55.1.11",
    "expo-notifications": "~55.0.24",
    "expo-secure-store": "~55.0.15",
    "expo-sharing": "~55.0.21",
    "expo-speech": "~55.0.15",
    "expo-splash-screen": "~55.0.22",
    "expo-status-bar": "~55.0.6",
    "expo-system-ui": "~55.0.19",
    "expo-task-manager": "~55.0.17",
    "expo-updates": "~55.0.25",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "react-native": "0.83.6",
    "react-native-blob-util": "^0.24.7",
    "react-native-expo-braintree": "^3.5.0",
    "react-native-gesture-handler": "~2.30.0",
    "react-native-pdf": "^7.0.4",
    "react-native-qrcode-svg": "^6.3.1",
    "react-native-safe-area-context": "~5.6.2",
    "react-native-screens": "~4.23.0",
    "react-native-svg": "15.15.3",
    "react-native-web": "^0.21.0",
    "react-native-webview": "13.16.0",
    "rn-truelayer-payments-sdk": "^3.1.2"
  },
  "devDependencies": {
    "@babel/core": "^7.25.2",
    "@types/jest": "^29.5.14",
    "@types/node": "^25.6.0",
    "@types/react": "~19.2.10",
    "babel-jest": "^29.7.0",
    "jest": "^29.7.0",
    "patch-package": "^8.0.1",
    "typescript": "^5.3.3"
  },
  "jest": {
    "testEnvironment": "node",
    "testMatch": [
      "**/__contract__/**/*.test.ts",
      "**/__tests__/**/*.test.ts"
    ],
    "transform": {
      "^.+\\.tsx?$": "babel-jest"
    }
  },
  "private": true,
  "expo": {
    "install": {
      "exclude": [
        "@stripe/stripe-react-native"
      ]
    },
    "doctor": {
      "reactNativeDirectoryCheck": {
        "exclude": [
          "react-native-expo-braintree",
          "rn-truelayer-payments-sdk"
        ],
        "listUnknownPackages": false
      }
    }
  }
}
