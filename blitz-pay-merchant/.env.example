# Select the backend profile with start:local/server or android:local/server.
EXPO_PUBLIC_BACKEND_TARGET=local

# Local backend and Keycloak
EXPO_PUBLIC_LOCAL_API_URL=http://127.0.0.1:8080
EXPO_PUBLIC_LOCAL_KEYCLOAK_URL=http://127.0.0.1:8084
EXPO_PUBLIC_LOCAL_KEYCLOAK_CLIENT_ID=blitzpay-mobile

# Staging backend and Keycloak
EXPO_PUBLIC_SERVER_API_URL=https://api-blitzpay-staging.zackpay.de
EXPO_PUBLIC_SERVER_KEYCLOAK_URL=https://auth.zackpay.de
EXPO_PUBLIC_SERVER_KEYCLOAK_CLIENT_ID=blitzpay-mobile-merchants

EXPO_PUBLIC_KEYCLOAK_REALM=blitzpay-business

# Skip Keycloak entirely for demos
EXPO_PUBLIC_AUTH_BYPASS=false

# Optional JDK 17 path used by Android launch commands.
# APP_JAVA_HOME=C:/path/to/jdk-17

# Fire OS / no-GMS testing: expo-location uses FusedLocationProvider (GMS-only) and always
# returns null on Fire OS. Set these to hardcoded coords to bypass location resolution entirely.
# Remove or leave blank on real devices with GMS.
# EXPO_PUBLIC_MOCK_LAT=48.8566
# EXPO_PUBLIC_MOCK_LNG=2.3522

# Dev only: use the Stripe Terminal simulated reader (ignored in release builds).
# Inlined at bundle time: restart Metro with `npx expo start -c --dev-client` after changing it.
# EXPO_PUBLIC_SIMULATED_READER=1
